<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivStepperMinus"
        android:layout_width="30dp"
        android:layout_height="0dp"
        android:background="@drawable/libs_widget_stepper_button"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:adjustViewBounds="true"
        android:src="@drawable/libs_widget_stepper_minus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivStepperPlus"
        android:layout_width="30dp"
        android:layout_height="0dp"
        android:background="@drawable/libs_widget_stepper_button"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/libs_widget_stepper_minus"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvStepperContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@id/ivStepperPlus"
        android:layout_toRightOf="@id/ivStepperMinus"
        android:background="@color/libs_widget_stepper_text_background"
        android:gravity="center"
        android:textColor="@color/libs_widget_stepper_text"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/ivStepperMinus"
        app:layout_constraintEnd_toStartOf="@id/ivStepperPlus"
        app:layout_constraintStart_toEndOf="@id/ivStepperMinus"
        app:layout_constraintTop_toTopOf="@id/ivStepperMinus"
        tools:text="100" />

</androidx.constraintlayout.widget.ConstraintLayout>